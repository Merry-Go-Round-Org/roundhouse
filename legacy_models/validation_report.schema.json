{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Merry-Go-Round-Org/merry_go_round_workspace/blob/legacy/legacy_models/validation_report.schema.json",
  "title": "EXL Legacy Model Validation Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "report_kind",
    "model_id",
    "domain",
    "task",
    "model_kind",
    "artifact_sha256",
    "checks",
    "summary",
    "saved_metrics",
    "limitations",
    "generated_at_utc",
    "policy_version",
    "execution_requested"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_kind": {
      "const": "legacy_model_validation"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "uci",
        "ulb",
        "survival_synthetic"
      ]
    },
    "task": {
      "enum": [
        "binary_classification",
        "survival_analysis"
      ]
    },
    "model_kind": {
      "enum": [
        "real_dataset",
        "synthetic_demo"
      ]
    },
    "model_status": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status",
          "required",
          "summary",
          "evidence_kind",
          "details"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "REVIEW",
              "NOT_ASSESSABLE",
              "NOT_APPLICABLE"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "evidence_kind": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "overall_status",
        "required_checks_passed",
        "blocking_check_ids",
        "review_check_ids",
        "human_approval_granted"
      ],
      "properties": {
        "overall_status": {
          "enum": [
            "VALIDATION_FAILED",
            "VALIDATION_INCOMPLETE",
            "REVIEW_REQUIRED"
          ]
        },
        "required_checks_passed": {
          "type": "boolean"
        },
        "blocking_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_approval_granted": {
          "const": false
        }
      }
    },
    "saved_metrics": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "execution_requested": {
      "type": "boolean"
    },
    "stability": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional independent-window score and feature PSI; null when monitoring evidence missing or invalid."
    }
  },
  "additionalProperties": false
}
