# Server-side Vite /api proxy target. Never put API keys or passwords here.
# HTTPS is required for remote targets; HTTP is supported for localhost only.
BACKEND_API_ORIGIN=http://127.0.0.1:8000

# Model ZIP uploads may queue billable OpenRouter documentation tasks.
# Enabled in this example for integration testing. Set false for auth-only testing.
VITE_ENABLE_PROPOSED_UPLOADS=true
