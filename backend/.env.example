# Copy to .env. Never commit real credentials.
APP_NAME="Model Risk Factory API"
API_PREFIX=/api/v1
# Browser origin must match the exact hostname and port shown in the address bar.
# localhost and 127.0.0.1 are distinct origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
# Relative paths are resolved from the backend directory.
STORAGE_DIR=storage
# Leave unset to use storage/app.db:
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/app.db
REDIS_URL=redis://localhost:6379/0

# Maximum async harness duration in seconds.
RUN_TIMEOUT_SECONDS=300

# Optional for non-AI workflows; required for live chat/document/rebuild. Never commit the real key.
OPENROUTER_API_KEY=

# Login to ghcr.io and pull this private image before starting scoring.
# Immutable local sha256 image IDs are also accepted; empty disables scoring.
SCORING_IMAGE=ghcr.io/merry-go-round-org/sandbox@sha256:8083453253c3267caaa0fe36b43a287b9a986d5784148ad40714cd9d3fc2d80e
SCORING_TIMEOUT_SECONDS=120

# Legacy test mode only. Normal human reviews use signed-in user sessions.
REVIEWER_TOKEN=
REVIEWER_ID=demo-reviewer
# Cumulative provider budget per database (USD); no key is needed for validation.
HARNESS_BUDGET_USD=1.0

# Shared-workspace login. Keep both false for a public HTTPS test endpoint.
ALLOW_LOCAL_DEMO_AUTH=false
ALLOW_LEGACY_REGISTRATION=false
# HTTPS requests also set Secure cookies automatically. Use true behind HTTPS-only hosting.
AUTH_COOKIE_SECURE=false
MAX_UPLOAD_BYTES=629145600
